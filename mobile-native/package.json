{
  "name": "valency-mobile-native",
  "version": "1.0.0",
  "private": true,
  "description": "Native iOS (TestFlight/App Store) & Android (.apk) Capacitor wrapper for VALENCY",
  "scripts": {
    "build:web": "node ../scripts/build-mobile-bundle.js",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build:web && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  }
}
